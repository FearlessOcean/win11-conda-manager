<Window x:Class="CondaManager.App.ChannelManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理渠道" Width="620" Height="605" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="#F7F8FA">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#A33C35" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="取消" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="保存" Padding="16,6" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="此安装的渠道设置" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="RootText" TextWrapping="Wrap" Foreground="#647284" Margin="0,2,0,14" />
            <RadioButton x:Name="InheritMode" GroupName="Mode" Content="沿用 Conda 当前渠道" Checked="Mode_Changed" />
            <Button x:Name="ReadButton" Content="查看 Conda 当前渠道" HorizontalAlignment="Left"
                    Padding="10,4" Margin="20,6,0,4" Click="Read_Click" />
            <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto" Margin="20,0,0,10">
                <TextBlock x:Name="ConfiguredText" TextWrapping="Wrap" Foreground="#647284" />
            </ScrollViewer>
            <RadioButton x:Name="CustomMode" GroupName="Mode" Content="使用本应用自定义渠道" Checked="Mode_Changed" />
            <TextBlock Text="按从高到低的优先级排列。渠道名称使用 Conda 当前的 channel_alias 解析。混用不兼容的渠道可能导致依赖冲突。"
                       TextWrapping="Wrap" Foreground="#647284" Margin="20,6,0,12" />
        </StackPanel>
        <DockPanel IsEnabled="{Binding IsChecked, ElementName=CustomMode}">
            <StackPanel DockPanel.Dock="Top">
                <Label Content="渠道名称或 HTTPS 地址" Target="{Binding ElementName=EntryText}" Padding="0" />
                <DockPanel Margin="0,4,0,8">
                    <Button DockPanel.Dock="Right" Content="添加" Padding="14,5" Margin="8,0,0,0" Click="Add_Click" />
                    <TextBox x:Name="EntryText" Padding="6,4" TextChanged="Entry_Changed" />
                </DockPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                <Button x:Name="UpButton" Content="上移" Padding="12,4" Click="Up_Click" />
                <Button x:Name="DownButton" Content="下移" Padding="12,4" Margin="0,6" Click="Down_Click" />
                <Button x:Name="RemoveButton" Content="移除" Padding="12,4" Click="Remove_Click" />
            </StackPanel>
            <ListBox x:Name="ChannelList" SelectionChanged="Selection_Changed" />
        </DockPanel>
    </DockPanel>
</Window>
