<Window x:Class="CondaManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conda 环境管理器" Width="920" Height="620" MinWidth="720" MinHeight="480"
        Background="#F7F8FA" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="96" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Conda 环境管理器" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="选择并验证本机已有的 Conda、Miniconda 或 Miniforge 安装"
                       Foreground="#566270" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding Installations}"
                      SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}"
                      MinHeight="36" Padding="8,4" VerticalContentAlignment="Center"
                      ToolTip="当前使用的 Conda 安装">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Info.RootPrefix}" />
                            <TextBlock Text="  ·  Conda " Foreground="#647284" />
                            <TextBlock Text="{Binding Info.CondaVersion}" Foreground="#647284" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="重新扫描" Style="{StaticResource ActionButton}"
                    Margin="12,0,8,0" Click="Refresh_Click" />
            <Button Grid.Column="2" Content="选择安装目录" Style="{StaticResource ActionButton}"
                    Margin="0" Click="Browse_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDE2E8"
                    BorderThickness="1" CornerRadius="8" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="安装信息" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="安装根目录" Foreground="#647284" />
                        <TextBlock Text="{Binding SelectedInstallation.Info.RootPrefix, TargetNullValue=尚未选择}"
                                   TextWrapping="Wrap" Margin="0,5,0,18" FontSize="15" />
                        <TextBlock Text="Conda 版本" Foreground="#647284" />
                        <TextBlock Text="{Binding SelectedInstallation.Info.CondaVersion, TargetNullValue=—}"
                                   Margin="0,5,0,18" FontSize="15" />
                        <TextBlock Text="环境默认目录候选" Foreground="#647284" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding SelectedInstallation.Info.EnvsDirs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="未发现可用的 Conda 安装。请手动选择安装根目录。"
                                   Foreground="#9A531F" Margin="0,18,0,0"
                                   Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DDE2E8"
                    BorderThickness="1" CornerRadius="8" Padding="22">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="扫描诊断" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Diagnostics}" BorderThickness="0"
                             Foreground="#566270" Background="Transparent" />
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <ProgressBar Height="4" IsIndeterminate="True" Margin="0,0,0,10"
                         Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#566270" />
        </StackPanel>
    </Grid>
</Window>
