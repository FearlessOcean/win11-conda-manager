<Window x:Class="CondaManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:CondaManager.Core;assembly=CondaManager.Core"
        Title="Conda 环境管理器" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="#F7F8FA" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#647284" />
        </Style>
        <Style x:Key="EnvironmentLoading" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Browser.EnvironmentState}" Value="{x:Static core:BrowserLoadState.Loading}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EnvironmentEmpty" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Browser.EnvironmentState}" Value="{x:Static core:BrowserLoadState.Empty}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EnvironmentError" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Browser.EnvironmentState}" Value="{x:Static core:BrowserLoadState.Error}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PackageLoading" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Browser.PackageState}" Value="{x:Static core:BrowserLoadState.Loading}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PackageEmpty" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Browser.PackageState}" Value="{x:Static core:BrowserLoadState.Empty}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PackageError" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Browser.PackageState}" Value="{x:Static core:BrowserLoadState.Error}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24" Background="#F7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Conda 环境管理器" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="浏览本机 Conda、Miniconda 和 Miniforge 的虚拟环境与软件包"
                       Foreground="#566270" Margin="0,5,0,0" />
            <Border Margin="0,12,0,0" Padding="12" Background="#EAF2FC" BorderBrush="#BCD2EE"
                    BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding HasOperationMessage, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding OperationStatusMessage}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#254E79" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOperationError}" Value="True">
                                            <Setter Property="Foreground" Value="#A33C35" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Height="4" IsIndeterminate="True" Margin="0,8,12,0"
                                     Visibility="{Binding IsOperating, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="取消操作" Padding="12,6" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsEnabled="{Binding CanCancelOperation}"
                            Visibility="{Binding IsOperating, Converter={StaticResource BooleanToVisibility}}"
                            Click="CancelOperation_Click" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding Discovery.Installations}"
                      SelectedItem="{Binding Discovery.SelectedInstallation, Mode=TwoWay}"
                      IsEnabled="{Binding CanInteract}"
                      MinHeight="36" Padding="8,4" VerticalContentAlignment="Center"
                      ToolTip="当前使用的 Conda 安装">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Info.RootPrefix}" />
                            <TextBlock Text="  ·  Conda " Foreground="#647284" />
                            <TextBlock Text="{Binding Info.CondaVersion}" Foreground="#647284" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="重新扫描" Margin="12,0,8,0" Click="Refresh_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Discovery.IsScanning}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOperating}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="2" Content="选择安装目录" Style="{StaticResource ActionButton}"
                    IsEnabled="{Binding CanInteract}" Click="Browse_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDE2E8"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="虚拟环境" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="新建" Padding="10,5" Margin="0,0,6,0"
                                IsEnabled="{Binding CanCreate}" Click="Create_Click" />
                        <Button Grid.Column="2" Content="刷新" Padding="10,5"
                                IsEnabled="{Binding CanCreate}" Click="EnvironmentRefresh_Click" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="正在读取环境列表…" Style="{StaticResource EnvironmentLoading}"
                                   Foreground="#647284" Margin="0,0,0,10" />
                        <TextBlock Text="该安装未返回任何环境。" Style="{StaticResource EnvironmentEmpty}"
                                   Foreground="#647284" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel Style="{StaticResource EnvironmentError}" Margin="0,0,0,10">
                            <TextBlock Text="读取环境列表失败" Foreground="#A33C35" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Browser.EnvironmentError}" TextWrapping="Wrap"
                                       Foreground="#A33C35" Margin="0,3,0,6" />
                            <Button Content="重试" HorizontalAlignment="Left" Padding="10,5"
                                    IsEnabled="{Binding CanInteract}" Click="EnvironmentRefresh_Click" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Browser.Environments}"
                             SelectedItem="{Binding Browser.SelectedEnvironment, Mode=OneWay}"
                             SelectionChanged="Environment_SelectionChanged"
                             IsEnabled="{Binding CanInteract}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,7">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Prefix}" TextWrapping="Wrap"
                                               Foreground="#647284" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DDE2E8"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="环境详情" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="删除环境" Padding="12,6"
                                IsEnabled="{Binding CanDelete}" Click="Delete_Click" />
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="存放位置" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding Browser.SelectedEnvironment.Prefix, TargetNullValue=请选择环境, FallbackValue=请选择环境}"
                                   TextWrapping="Wrap" FontSize="14" Margin="0,3,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Python 版本：" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding Browser.PythonVersion, TargetNullValue=—}" Margin="0,0,26,0" />
                            <TextBlock Text="软件包：" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding Browser.TotalPackageCount}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="安装软件包" Padding="12,6" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanInstallPackage}" Click="InstallPackage_Click" />
                            <Button Content="更新选中项" Padding="12,6" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanChangeSelectedPackage}" Click="UpdatePackage_Click" />
                            <Button Content="卸载选中项" Padding="12,6"
                                    IsEnabled="{Binding CanChangeSelectedPackage}" Click="RemovePackage_Click" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="搜索可用包" Padding="12,6" Margin="0,0,8,4"
                                    IsEnabled="{Binding CanBrowseChannels}" Click="SearchPackages_Click" />
                            <Button Content="管理渠道" Padding="12,6" Margin="0,0,10,4"
                                    IsEnabled="{Binding CanBrowseChannels}" Click="ManageChannels_Click" />
                            <TextBlock Text="{Binding ChannelModeLabel}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                        </WrapPanel>
                        <TextBlock Text="筛选已安装的软件包（名称或版本）" Style="{StaticResource MutedText}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding Browser.PackageSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="9,7" MinHeight="34" IsEnabled="{Binding CanInteract}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,0,0,8">
                        <TextBlock Text="正在读取软件包…" Style="{StaticResource PackageLoading}"
                                   Foreground="#647284" />
                        <TextBlock Text="该环境没有可显示的软件包。" Style="{StaticResource PackageEmpty}"
                                   Foreground="#647284" />
                        <StackPanel Style="{StaticResource PackageError}">
                            <TextBlock Text="读取软件包失败" Foreground="#A33C35" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Browser.PackageError}" TextWrapping="Wrap"
                                       Foreground="#A33C35" Margin="0,3,0,6" />
                            <Button Content="重试" HorizontalAlignment="Left" Padding="10,5"
                                    IsEnabled="{Binding CanInteract}" Click="PackageRefresh_Click" />
                        </StackPanel>
                        <TextBlock Text="没有匹配的软件包。" Foreground="#647284"
                                   Visibility="{Binding Browser.HasFilteredNoResults, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                    <DataGrid Grid.Row="4" ItemsSource="{Binding Browser.VisiblePackages}"
                              x:Name="PackageGrid" IsEnabled="{Binding CanInteract}"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              SelectionChanged="PackageSelection_Changed"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderBrush="#DDE2E8" AlternatingRowBackground="#F7F8FA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="*" />
                            <DataGridTextColumn Header="构建" Binding="{Binding Build}" Width="*" />
                            <DataGridTextColumn Header="渠道" Binding="{Binding Channel}" Width="*" />
                            <DataGridTemplateColumn Header="软件包来源" Width="SizeToHeader">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="未知（只读）" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Origin}" Value="Conda">
                                                            <Setter Property="Text" Value="Conda" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Origin}" Value="Pip">
                                                            <Setter Property="Text" Value="pip（只读）" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Expander Grid.Row="3" Header="安装信息与扫描诊断" Margin="0,12,0,0">
            <Grid Margin="0,10,0,0" MaxHeight="120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="默认环境目录候选" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Discovery.SelectedInstallation.Info.EnvsDirs}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="扫描诊断" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Discovery.Diagnostics}" BorderThickness="0"
                             Background="Transparent" Foreground="#566270" />
                </StackPanel>
            </Grid>
        </Expander>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar Height="4" IsIndeterminate="True" Margin="0,0,0,8"
                         Visibility="{Binding Discovery.IsScanning, Converter={StaticResource BooleanToVisibility}}" />
            <TextBlock Text="{Binding Discovery.StatusMessage}" Foreground="#566270" />
        </StackPanel>
    </Grid>
</Window>
