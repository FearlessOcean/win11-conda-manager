<Window x:Class="CondaManager.App.InstallPackageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 Conda 软件包" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F7F8FA" FontFamily="Segoe UI">
    <StackPanel Margin="24">
        <TextBlock Text="目标环境" Foreground="#647284" />
        <TextBlock x:Name="TargetTextBlock" TextWrapping="Wrap" Margin="0,4,0,8" />
        <TextBlock Text="构建和渠道由 Conda 求解，可能与搜索结果不同。请在变更预览中核对。"
                   Foreground="#647284" Margin="0,0,0,18" />

        <Label Target="{Binding ElementName=NameTextBox}" Content="软件包名称"
               Padding="0" FontWeight="SemiBold" />
        <TextBox x:Name="NameTextBox" MinHeight="34" Padding="8,6"
                 Margin="0,5,0,4" TextChanged="Input_TextChanged" />
        <TextBlock x:Name="NameHint" Text="最多 64 个字符。以英文字母或数字开头，可包含下划线、连字符和句点。"
                   Foreground="#647284" TextWrapping="Wrap" Margin="0,0,0,16" />

        <Label Target="{Binding ElementName=VersionTextBox}" Content="版本（可选）"
               Padding="0" FontWeight="SemiBold" />
        <TextBox x:Name="VersionTextBox" MinHeight="34" Padding="8,6"
                 Margin="0,5,0,4" TextChanged="Input_TextChanged" />
        <TextBlock x:Name="VersionHint" Text="手动输入按版本前缀匹配，例如 1.26。留空时由 Conda 选择版本。"
                   Foreground="#647284" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock Text="软件包参数" FontWeight="SemiBold" />
        <Border Background="White" BorderBrush="#DDE2E8" BorderThickness="1"
                CornerRadius="5" Padding="10" Margin="0,5,0,8">
            <TextBlock x:Name="SpecTextBlock" Text="—" TextWrapping="Wrap" />
        </Border>
        <TextBlock x:Name="ValidationTextBlock" Foreground="#A33C35"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" Padding="18,8" Margin="0,0,8,0" />
            <Button x:Name="PreviewButton" Content="预览变更" IsDefault="True"
                    IsEnabled="False" Padding="18,8" Click="Preview_Click" />
        </StackPanel>
    </StackPanel>
</Window>
