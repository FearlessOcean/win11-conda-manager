<Window x:Class="CondaManager.App.PackageSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索可用包" Icon="pack://application:,,,/CondaManager.App;component/Assets/AppIcon.ico" Width="850" Height="560" MinWidth="550" MinHeight="370"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="#F7F8FA">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="ChannelText" TextWrapping="Wrap" Foreground="#647284" />
            <Label Content="搜索词（3–64 个字符）" Target="{Binding ElementName=QueryText}" Padding="0" Margin="0,12,0,4" />
            <DockPanel>
                <Button x:Name="CancelSearchButton" DockPanel.Dock="Right" Content="取消搜索" Padding="12,5"
                        IsEnabled="{Binding IsSearching}" Margin="8,0,0,0" Click="CancelSearch_Click" />
                <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="搜索" IsDefault="True"
                        Padding="14,5" Margin="8,0,0,0" Click="Search_Click" />
                <TextBox x:Name="QueryText" Padding="8,5" MaxLength="64"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,8" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="InstallButton" Content="安装此版本" Padding="14,6"
                        Margin="0,0,8,0" Click="Install_Click" />
                <Button Content="关闭" IsCancel="True" Padding="14,6" />
            </StackPanel>
            <TextBlock x:Name="TargetHint" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#647284" />
        </DockPanel>
        <DataGrid x:Name="ResultGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="*" />
                <DataGridTextColumn Header="构建" Binding="{Binding Build}" Width="1.5*" />
                <DataGridTextColumn Header="渠道" Binding="{Binding ChannelLabel}" Width="1.5*" />
                <DataGridTextColumn Header="平台" Binding="{Binding Subdir}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
