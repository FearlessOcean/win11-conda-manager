<Window x:Class="CondaManager.App.CreateEnvironmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建 Conda 虚拟环境" Icon="pack://application:,,,/CondaManager.App;component/Assets/AppIcon.ico" Width="650" Height="620" MinWidth="520" MinHeight="590"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F7F8FA" FontFamily="Segoe UI">
    <Grid Margin="24" Background="#F7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="创建虚拟环境" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="先确认最终存放位置，再开始安装 Python。"
                       Foreground="#566270" Margin="0,5,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="当前 Conda 安装" Foreground="#647284" />
                <TextBlock x:Name="InstallationTextBlock" TextWrapping="Wrap"
                           Margin="0,4,0,17" />

                <TextBlock Text="环境名称" FontWeight="SemiBold" />
                <TextBox x:Name="NameTextBox" MinHeight="34" Padding="8,6"
                         Margin="0,5,0,4" TextChanged="Input_TextChanged" />
                <TextBlock Text="可使用中文、英文字母、数字、下划线和连字符；不能包含空格。"
                           Foreground="#647284" FontSize="11" Margin="0,0,0,16" />

                <TextBlock Text="Python 版本（可选）" FontWeight="SemiBold" />
                <TextBox x:Name="VersionTextBox" MinHeight="34" Padding="8,6"
                         Margin="0,5,0,4" TextChanged="Input_TextChanged" />
                <TextBlock Text="例如 3.12；留空时由 Conda 渠道选择默认版本。"
                           Foreground="#647284" FontSize="11" Margin="0,0,0,16" />

                <TextBlock Text="存放目录（默认位置，可更改）" FontWeight="SemiBold" />
                <Grid Margin="0,5,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ParentTextBox" Grid.Column="0" MinHeight="34"
                             Padding="8,6" Margin="0,0,8,0"
                             TextChanged="Input_TextChanged"
                             HorizontalScrollBarVisibility="Auto" />
                    <Button Grid.Column="1" Content="浏览…" Padding="14,7"
                            Click="Browse_Click" />
                </Grid>
                <TextBlock x:Name="DefaultHintTextBlock" Foreground="#647284"
                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16" />

                <TextBlock Text="最终环境路径" FontWeight="SemiBold" />
                <Border Background="White" BorderBrush="#DDE2E8" BorderThickness="1"
                        CornerRadius="5" Padding="10" Margin="0,5,0,8">
                    <TextBlock x:Name="PreviewTextBlock" Text="请输入名称和存放目录"
                               TextWrapping="Wrap" Foreground="#304254" />
                </Border>
                <TextBlock x:Name="ValidationTextBlock" Foreground="#A33C35"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" Padding="18,8"
                    Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="CreateButton" Content="创建环境" IsDefault="True"
                    IsEnabled="False" Padding="18,8" Click="Create_Click" />
        </StackPanel>
    </Grid>
</Window>
