<Window x:Class="CondaManager.App.PackagePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认 Conda 软件包变更" Icon="pack://application:,,,/CondaManager.App;component/Assets/AppIcon.ico" Width="640" Height="540" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#F7F8FA" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="ActionTextBlock" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="目标环境" Foreground="#647284" Margin="0,12,0,4" />
            <TextBlock x:Name="TargetTextBlock" TextWrapping="Wrap" />
            <TextBlock x:Name="PlanTextBlock" Foreground="#566270" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>

        <ScrollViewer x:Name="ChangesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PlanGroups" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" IsDefault="True"
                    Padding="18,8" />
            <Button x:Name="ConfirmButton" Content="确认执行" Padding="18,8"
                    Margin="8,0,0,0" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
